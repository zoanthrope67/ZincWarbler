[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/pause_menu.gd" id="1_pause"]
[ext_resource type="Script" path="res://scripts/ui/menu_list.gd" id="2_menu_list"]

[sub_resource type="Animation" id="Animation_reset"]
length = 0.001
tracks/0/type = "value"
tracks/0/imported = false
tracks/0/enabled = true
tracks/0/path = NodePath("CountdownScreen/Center/PlaceholderCountdownNumber:scale")
tracks/0/interp = 1
tracks/0/loop_wrap = true
tracks/0/keys = {
"times": PackedFloat32Array(0),
"transitions": PackedFloat32Array(1),
"update": 0,
"values": [Vector2(1, 1)]
}
tracks/1/type = "value"
tracks/1/imported = false
tracks/1/enabled = true
tracks/1/path = NodePath("CountdownScreen/Center/PlaceholderCountdownNumber:modulate")
tracks/1/interp = 1
tracks/1/loop_wrap = true
tracks/1/keys = {
"times": PackedFloat32Array(0),
"transitions": PackedFloat32Array(1),
"update": 0,
"values": [Color(1, 1, 1, 1)]
}

[sub_resource type="Animation" id="Animation_tick"]
length = 1.0
tracks/0/type = "value"
tracks/0/imported = false
tracks/0/enabled = true
tracks/0/path = NodePath("CountdownScreen/Center/PlaceholderCountdownNumber:scale")
tracks/0/interp = 1
tracks/0/loop_wrap = true
tracks/0/keys = {
"times": PackedFloat32Array(0, 0.25, 1),
"transitions": PackedFloat32Array(0.5, 1, 1),
"update": 0,
"values": [Vector2(1.8, 1.8), Vector2(1, 1), Vector2(0.85, 0.85)]
}
tracks/1/type = "value"
tracks/1/imported = false
tracks/1/enabled = true
tracks/1/path = NodePath("CountdownScreen/Center/PlaceholderCountdownNumber:modulate")
tracks/1/interp = 1
tracks/1/loop_wrap = true
tracks/1/keys = {
"times": PackedFloat32Array(0, 0.15, 0.75, 1),
"transitions": PackedFloat32Array(1, 1, 1, 1),
"update": 0,
"values": [Color(1, 1, 1, 0), Color(1, 1, 1, 1), Color(1, 1, 1, 1), Color(1, 1, 1, 0)]
}

[sub_resource type="AnimationLibrary" id="AnimationLibrary_pause"]
_data = {
&"RESET": SubResource("Animation_reset"),
&"countdown_tick": SubResource("Animation_tick")
}

[node name="PauseMenu" type="CanvasLayer"]
process_mode = 3
layer = 10
script = ExtResource("1_pause")

[node name="MenuScreen" type="Control" parent="."]
unique_name_in_owner = true
visible = false
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="Dim" type="ColorRect" parent="MenuScreen"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0, 0, 0, 0.6)

[node name="Center" type="CenterContainer" parent="MenuScreen"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="Layout" type="VBoxContainer" parent="MenuScreen/Center"]
layout_mode = 2
theme_override_constants/separation = 48

[node name="Title" type="Label" parent="MenuScreen/Center/Layout"]
layout_mode = 2
theme_override_font_sizes/font_size = 96
text = "PAUSED"
horizontal_alignment = 1

[node name="Menu" type="VBoxContainer" parent="MenuScreen/Center/Layout"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 16
script = ExtResource("2_menu_list")

[node name="Resume" type="Label" parent="MenuScreen/Center/Layout/Menu"]
layout_mode = 2
text = "Resume"
horizontal_alignment = 1

[node name="Restart" type="Label" parent="MenuScreen/Center/Layout/Menu"]
layout_mode = 2
text = "Restart (hold Confirm)"
horizontal_alignment = 1

[node name="Exit" type="Label" parent="MenuScreen/Center/Layout/Menu"]
layout_mode = 2
text = "Exit to Main Menu (hold Confirm)"
horizontal_alignment = 1

[node name="HoldBar" type="ProgressBar" parent="MenuScreen/Center/Layout"]
unique_name_in_owner = true
custom_minimum_size = Vector2(480, 24)
layout_mode = 2
size_flags_horizontal = 4
max_value = 1.0
step = 0.0
show_percentage = false

[node name="Warning" type="Label" parent="MenuScreen/Center/Layout"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.55, 0.35, 1)
theme_override_font_sizes/font_size = 32
text = "Your score would make the hi-score table.
Restart will NOT save it."
horizontal_alignment = 1

[node name="CountdownScreen" type="Control" parent="."]
unique_name_in_owner = true
visible = false
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="Center" type="CenterContainer" parent="CountdownScreen"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="PlaceholderCountdownNumber" type="Label" parent="CountdownScreen/Center"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.85, 0.2, 1)
theme_override_colors/font_outline_color = Color(0, 0, 0, 1)
theme_override_constants/outline_size = 24
theme_override_font_sizes/font_size = 240
text = "3"
horizontal_alignment = 1

[node name="AnimationPlayer" type="AnimationPlayer" parent="."]
libraries/ = SubResource("AnimationLibrary_pause")
