[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/states/name_entry.gd" id="1_name_entry"]

[node name="NameEntry" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_name_entry")

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Layout" type="VBoxContainer" parent="Center"]
layout_mode = 2
theme_override_constants/separation = 36

[node name="Title" type="Label" parent="Center/Layout"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.85, 0.2, 1)
theme_override_font_sizes/font_size = 72
text = "NEW HI-SCORE!"
horizontal_alignment = 1

[node name="ResultLabel" type="Label" parent="Center/Layout"]
unique_name_in_owner = true
layout_mode = 2
text = "SCORE 0    TIME 0:00"
horizontal_alignment = 1

[node name="NameLabel" type="Label" parent="Center/Layout"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 72
text = "_ _ _ _ _ _ _ _"
horizontal_alignment = 1

[node name="Characters" type="GridContainer" parent="Center/Layout"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 4
theme_override_constants/h_separation = 8
theme_override_constants/v_separation = 8
columns = 9

[node name="Buttons" type="HBoxContainer" parent="Center/Layout"]
layout_mode = 2
theme_override_constants/separation = 120
alignment = 1

[node name="Backspace" type="Label" parent="Center/Layout/Buttons"]
unique_name_in_owner = true
custom_minimum_size = Vector2(320, 72)
layout_mode = 2
text = "BACKSPACE"
horizontal_alignment = 1
vertical_alignment = 1

[node name="End" type="Label" parent="Center/Layout/Buttons"]
unique_name_in_owner = true
custom_minimum_size = Vector2(320, 72)
layout_mode = 2
text = "END"
horizontal_alignment = 1
vertical_alignment = 1

[node name="Hint" type="Label" parent="Center/Layout"]
layout_mode = 2
theme_override_colors/font_color = Color(0.65, 0.65, 0.7, 1)
theme_override_font_sizes/font_size = 32
text = "Confirm: add letter    Back: delete"
horizontal_alignment = 1
