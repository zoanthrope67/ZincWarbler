config_version=5

[application]

config/name="Zinc Warbler"
run/main_scene="uid://dolkgtbfxq6bm"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Settings="*res://scripts/autoload/settings.gd"
Hiscores="*res://scripts/autoload/hiscores.gd"
